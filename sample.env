DOCKER_HOST="unix:///var/run/docker.sock"
SANDBOX_TIMEOUT=300
MAX_SANDBOXES=10
DOCKER_IMAGE="fastomop/sandbox:python-3.11-slim"
DEBUG=false
LOG_LEVEL=INFO

# Sandbox runtime options
SANDBOX_ALLOW_HOST_GATEWAY=false
SANDBOX_READ_ONLY=true
# SANDBOX_NETWORK=auto  # Use compose network if detected, or set a specific Docker network name
# ALLOW_UNSAFE_SQL=false  # Allow raw WHERE clauses in query_omop_table (not recommended)

# Database configuration
DB_HOST=db
DB_PORT=5432
DB_USER=omcp
DB_PASSWORD=postgres
DB_NAME=omcp
