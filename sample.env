DOCKER_HOST="unix:///var/run/docker.sock"
SANDBOX_TIMEOUT=300
MAX_SANDBOXES=10
DOCKER_IMAGE="fastomop/sandbox:python-3.11-slim"
DEBUG=false
LOG_LEVEL=INFO

# Sandbox runtime options
SANDBOX_ALLOW_HOST_GATEWAY=false
SANDBOX_READ_ONLY=true
# Network access is disabled when SANDBOX_NETWORK is unset. Set a dedicated,
# restricted Docker network name only when a workflow explicitly requires it.
# SANDBOX_NETWORK=restricted-egress
SANDBOX_REQUIRE_PINNED_IMAGE=false

# Host-enforced execution policy
EXECUTION_DEFAULT_TIMEOUT=30
EXECUTION_MAX_TIMEOUT=300
EXECUTION_MAX_OUTPUT_BYTES=1048576

# Package installation is disabled by default. When enabled, callers must use
# exact name==version requirements from this comma-separated package allowlist.
PACKAGE_INSTALL_ENABLED=false
PACKAGE_ALLOWLIST=

# Query data-minimisation controls
QUERY_DEFAULT_LIMIT=100
QUERY_MAX_ROWS=1000

# Database configuration
DB_HOST=db
DB_PORT=5432
DB_USER=omcp
DB_PASSWORD=postgres
DB_NAME=omcp
