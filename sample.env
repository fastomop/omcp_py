DOCKER_HOST="unix:///var/run/docker.sock"
SANDBOX_TIMEOUT=300
MAX_SANDBOXES=10
DOCKER_IMAGE="fastomop/sandbox:python-3.11-slim"
DEBUG=false
LOG_LEVEL=INFO

# Sandbox runtime options
SANDBOX_ALLOW_HOST_GATEWAY=false
SANDBOX_READ_ONLY=true
# SANDBOX_NETWORK=auto  # Optional: use compose network if detected, or set a specific Docker network name
# Query data-minimisation controls
QUERY_DEFAULT_LIMIT=100
QUERY_MAX_ROWS=1000

# Database configuration
DB_HOST=db
DB_PORT=5432
DB_USER=omcp
DB_PASSWORD=postgres
DB_NAME=omcp
