DOCKER_HOST="unix:///var/run/docker.sock"
SANDBOX_TIMEOUT=300
MAX_SANDBOXES=10
DOCKER_IMAGE="fastomop/sandbox:python-3.11-slim"
DEBUG=false
LOG_LEVEL=INFO

# Sandbox runtime options
SANDBOX_ALLOW_HOST_GATEWAY=true
SANDBOX_READ_ONLY=false
# SANDBOX_NETWORK=  # Optional: specify a specific Docker network

# Database configuration
DB_HOST=db
DB_PORT=5432
DB_USER=omcp
DB_PASSWORD=postgres
DB_NAME=omcp